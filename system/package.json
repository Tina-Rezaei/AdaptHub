{
  "name": "hubos-core",
  "version": "0.0.1",
  "description": "AdaptHub/HubOS core - Privacy-driven smart home hub",
  "main": "start.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    
    "help": "node start.js --help",
    
    "dev": "NODE_ENV=dev node start.js",
    "prod": "NODE_ENV=production node start.js",
    
    "butler": "NODE_ENV=dev node start.js --app=Butler",
    "butlerlocal": "NODE_ENV=dev node start.js --app=ButlerLocal",
    "fallwatch": "NODE_ENV=dev node start.js --app=FallWatch",
    "smartcamera": "NODE_ENV=dev node start.js --app=SmartCamera",
    
    "eval": "NODE_ENV=production node start.js --eval",
    "eval:adapthub": "NODE_ENV=production node start.js --eval --mode=adapthub",
    "eval:localOnly": "NODE_ENV=production node start.js --eval --mode=localOnly",
    "eval:cloudOnly": "NODE_ENV=production node start.js --eval --mode=cloudOnly",
    "eval:adaptHubAlpha": "NODE_ENV=production node start.js --eval --mode=adaptHubAlpha",
    "eval:noPrivacy": "NODE_ENV=production node start.js --eval --mode=noPrivacy",
    
    "eval-butler": "NODE_ENV=production node start.js --eval --app=Butler",
    "eval-butlerlocal": "NODE_ENV=production node start.js --eval --app=ButlerLocal",
    "eval-fallwatch": "NODE_ENV=production node start.js --eval --app=FallWatch",
    "eval-smartcamera": "NODE_ENV=production node start.js --eval --app=SmartCamera"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudLargeScale-UCLouvain/hubos-dev.git"
  },
  "keywords": [
    "smart",
    "home",
    "privacy",
    "iot",
    "edge-computing",
    "adapthub",
    "hubos"
  ],
  "author": "Igor Zavalyshyn",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CloudLargeScale-UCLouvain/hubos-dev/issues"
  },
  "homepage": "https://github.com/CloudLargeScale-UCLouvain/hubos-dev#readme",
  "dependencies": {
    "dotenv": "^16.0.3",
    "mqtt": "^4.3.8",
    "proper-lockfile": "^4.1.2",
    "redis": "^4.3.0",
    "systeminformation": "^5.23.5",
    "vm2": "^3.9.10",
    "winston": "^3.8.2",
    "ws": "^8.9.0"
  }
}
